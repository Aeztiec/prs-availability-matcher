# Template for the bot's local config.
#
# Copy to .env and fill in. .env is gitignored - never commit real values,
# because this repo is public and a leaked token is a bot somebody else
# controls. If one leaks, regenerate it at discord.com/developers/applications
# -> your app -> Bot -> Reset Token; rotating is the only fix.

# Required. discord.com/developers/applications -> New Application -> Bot ->
# Reset Token -> copy. It looks like  MTIzNDU2Nzg5.GaBcDe.xxxxxxxxxxxxxxxxxxx
DISCORD_TOKEN=

# Required. Your server's ID. Right-click the server -> Copy Server ID
# (needs Settings -> Advanced -> Developer Mode switched on).
DISCORD_GUILD_ID=

# Optional but recommended: the role allowed to run the staff commands.
# Right-click the role -> Copy Role ID. Left blank, any member with Manage
# Server can use them.
DISCORD_STAFF_ROLE_ID=

# Optional: the referee role. It is pinged when a referee board is first
# published. Referees are registered one at a time with /refs register.
DISCORD_REFEREE_ROLE_ID=

# Optional: which timings sheet the fallback and the slot list come from, by
# its data/timings/ filename stem, e.g. S17_Clubs. Left blank it uses the
# newest season, preferring Clubs.
PRS_COMPETITION=

# Optional: who gets pinged at the top of a gameweek announcement. Defaults to
# @everyone. Use a role instead with "<@&123456789>", or leave it set to
# nothing to announce without pinging anybody. Only the first post notifies -
# the announcement is edited as fixtures get times, and edits do not re-ping.
DISCORD_ANNOUNCE_MENTION=
